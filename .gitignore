# Fichiers de configuration locale et secrets
# Même si vous ne l'utilisez pas, c'est une bonne pratique de l'inclure.
.env

# Fichiers générés par le bot lui-même
# C'est la section la plus importante pour vous !
collection.db
collection.db-journal
reset_done.lock

# Cartes composées générées au runtime (régénérables depuis les sources)
assets/card_cache/

# NB: assets/cutouts/ (portraits détourés, générés par tools/build_cutouts.py) est
# VERSIONNÉ dans le repo (décision actée) — le bot live en a besoin pour le rendu v2.

# Prototypes jetables
proto_out/

# Prompts Midjourney générés (régénérables depuis data/roster_s2.json)
out/

# NB: refs/ (portraits officiels LNH, récupérés par tools/fetch_lnh_s2.py) est
# VERSIONNÉ volontairement : Midjourney lit les --oref par URL publique, et le
# raw GitHub du repo sert d'hébergement.

# Fichiers cache et compilés de Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Dossiers d'environnement virtuel Python
venv/
.venv/
env/
.env/

# Dossiers de configuration de l'éditeur de code (ex: VS Code, PyCharm)
.vscode/
.idea/

# Sauvegardes horodatees prises par tools/publier_s2.py et tools/migration_s2.py
*.bak
